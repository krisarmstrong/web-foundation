#!/usr/bin/env sh

# Block AI co-author references
COMMIT_MSG=$(cat "$1")
if echo "$COMMIT_MSG" | grep -qiE "(co-authored-by.*(claude|anthropic|chatgpt|openai|copilot)|generated with.*claude|\[Claude Code\]|@anthropic\.com|@openai\.com)"; then
  echo ""
  echo "═══════════════════════════════════════════════════════════════"
  echo "  COMMIT BLOCKED: AI Co-Author Reference Detected"
  echo "═══════════════════════════════════════════════════════════════"
  echo ""
  echo "Remove AI attribution (Co-Authored-By, Generated with Claude, etc.)"
  echo ""
  exit 1
fi

